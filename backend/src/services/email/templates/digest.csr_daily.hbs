<h2 style="margin:0 0 12px 0;font-size:18px;font-weight:600;color:#0f172a;">Today's AI reviews on your work</h2>
<p style="margin:0 0 16px 0;">Hi {{recipient.username}},</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 16px 0;border-collapse:collapse;">
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;width:160px;">Reviews</td><td style="padding:6px 0;font-size:13px;font-weight:600;">{{itemCount}}</td></tr>
  {{#if avgScore}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Average</td><td style="padding:6px 0;font-size:13px;">{{avgScore}}%</td></tr>{{/if}}
  {{#if criticalFailCount}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Critical fails</td><td style="padding:6px 0;font-size:13px;font-weight:600;color:#dc2626;">{{criticalFailCount}}</td></tr>{{/if}}
  {{#if trendLabel}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">vs your 30-day avg</td><td style="padding:6px 0;font-size:13px;">{{trendLabel}}</td></tr>{{/if}}
</table>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 16px 0;border-collapse:collapse;border:1px solid #e2e8f0;">
  <thead>
    <tr style="background:#f8fafc;">
      <th style="padding:8px 12px;text-align:left;font-size:12px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;">Form</th>
      <th style="padding:8px 12px;text-align:right;font-size:12px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;">Score</th>
      <th style="padding:8px 12px;text-align:left;font-size:12px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;">Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td style="padding:8px 12px;font-size:13px;border-bottom:1px solid #f1f5f9;">{{this.formName}}</td>
      <td style="padding:8px 12px;font-size:13px;text-align:right;border-bottom:1px solid #f1f5f9;">{{this.score}}%</td>
      <td style="padding:8px 12px;font-size:13px;color:#64748b;border-bottom:1px solid #f1f5f9;">{{this.status}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{#if hasMore}}<p style="margin:0 0 16px 0;font-size:12px;color:#64748b;font-style:italic;">Showing the first {{itemCount}} of today's reviews.</p>{{/if}}
{{> button url=(appUrl deepLinkPath) label="View All in QTIP" }}
