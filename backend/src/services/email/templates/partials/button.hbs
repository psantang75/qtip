<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:separate;line-height:100%;margin:16px 0;">
  <tr>
    <td align="center" valign="middle" bgcolor="#00aeef" role="presentation" style="border-radius:6px;background:#00aeef;cursor:auto;mso-padding-alt:10px 20px 10px 20px;">
      <a href="{{url}}" target="_blank" rel="noopener noreferrer" style="background:#00aeef;border:1px solid #00aeef;border-radius:6px;color:#ffffff;display:inline-block;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;line-height:120%;margin:0;padding:10px 20px;text-decoration:none;text-transform:none;mso-padding-alt:0;">{{label}}</a>
    </td>
  </tr>
</table>
