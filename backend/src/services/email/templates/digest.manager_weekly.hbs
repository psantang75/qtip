<h2 style="margin:0 0 12px 0;font-size:18px;font-weight:600;color:#0f172a;">Your team's AI reviews this week</h2>
<p style="margin:0 0 16px 0;">Hi {{recipient.username}},</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 16px 0;border-collapse:collapse;">
  {{#if teamAvg}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;width:200px;">Team average</td><td style="padding:6px 0;font-size:13px;font-weight:600;">{{teamAvg}}%{{#if deltaLabel}} ({{deltaLabel}} vs prior week){{/if}}</td></tr>{{/if}}
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Reviews</td><td style="padding:6px 0;font-size:13px;font-weight:600;">{{itemCount}}</td></tr>
  {{#if criticalFailCount}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Critical fails</td><td style="padding:6px 0;font-size:13px;font-weight:600;color:#dc2626;">{{criticalFailCount}}</td></tr>{{/if}}
  {{#if disputesOpenedCount}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Disputes opened</td><td style="padding:6px 0;font-size:13px;">{{disputesOpenedCount}}</td></tr>{{/if}}
</table>
{{#if topPerformers.length}}
<p style="margin:0 0 6px 0;font-size:13px;color:#0f172a;font-weight:600;">Top performers</p>
<ul style="margin:0 0 16px 18px;padding:0;font-size:13px;color:#0f172a;">
  {{#each topPerformers}}<li style="margin:2px 0;">{{this.csrName}} — {{this.avg}}% ({{this.reviews}} reviews)</li>{{/each}}
</ul>
{{/if}}
{{#if needsAttention.length}}
<p style="margin:0 0 6px 0;font-size:13px;color:#0f172a;font-weight:600;">Needs attention</p>
<ul style="margin:0 0 16px 18px;padding:0;font-size:13px;color:#0f172a;">
  {{#each needsAttention}}<li style="margin:2px 0;">{{this.csrName}} — {{this.avg}}% ({{this.reviews}} reviews{{#if this.criticalFails}}, {{this.criticalFails}} critical{{/if}})</li>{{/each}}
</ul>
{{/if}}
{{> button url=(appUrl deepLinkPath) label="Open Team Dashboard" }}
