<h2 style="margin:0 0 12px 0;font-size:18px;font-weight:600;color:#0f172a;">Coaching session scheduled</h2>
<p style="margin:0 0 16px 0;">Hi {{recipient.username}},</p>
<p style="margin:0 0 16px 0;">A coaching session has been scheduled for you.</p>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0 0 16px 0;border-collapse:collapse;">
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;width:140px;">When</td><td style="padding:6px 0;font-size:13px;font-weight:600;">{{formatDateTime session.session_date}}</td></tr>
  {{#if session.duration_minutes}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Duration</td><td style="padding:6px 0;font-size:13px;">{{session.duration_minutes}} minutes</td></tr>{{/if}}
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Format</td><td style="padding:6px 0;font-size:13px;">{{session.coaching_format}}</td></tr>
  {{#if session.location}}<tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Where</td><td style="padding:6px 0;font-size:13px;">{{session.location}}</td></tr>{{/if}}
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Coach</td><td style="padding:6px 0;font-size:13px;">{{coach.username}}</td></tr>
  <tr><td style="padding:6px 0;font-size:13px;color:#64748b;">Purpose</td><td style="padding:6px 0;font-size:13px;">{{session.coaching_purpose}}</td></tr>
</table>
{{> button url=(appUrl deepLinkPath) label="View Session" }}
{{#if session.preparation_notes}}
<p style="margin:16px 0 6px 0;font-size:13px;color:#0f172a;font-weight:600;">To prepare</p>
<p style="margin:0;font-size:13px;color:#0f172a;">{{session.preparation_notes}}</p>
{{/if}}
