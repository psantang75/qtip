  @@map("calls")
}

model Submission {
  id           Int              @id @default(autoincrement())
  form_id      Int
  call_id      Int?
  /// Phase C (C4): multi-source case the submission belongs to. Format
  /// `<KIND>:<external_id>` — the KIND/id of the primary source. Lets
  /// the inbox / calibration / readiness logic group multiple
  /// submissions (AI run + later sample-review run) under the same case.
  case_id      String?          @db.VarChar(64)
  /// AI Reviewer provider that authored this DRAFT (multi-source
  /// chunked-synthesis runs only). NULL for human-authored submissions
  /// AND for legacy AI rows created before this column existed. Used as
  /// part of the DRAFT dedup key so compare-mode runs (Claude vs ChatGPT
  /// on the same case) land in two distinct rows.
  ai_provider  String?          @db.VarChar(16)
  submitted_by Int
  submitted_at DateTime         @default(now()) @db.DateTime(0)
  total_score  Decimal?         @db.Decimal(5, 2)
  status       SubmissionStatus @default(DRAFT)
  critical_fail_count Int       @default(0)
  score_capped Boolean          @default(false) @db.TinyInt
  ai_overall_confidence    Decimal? @db.Decimal(3, 2)
  ai_calibrated_confidence Decimal? @db.Decimal(3, 2)
  ai_extras    Json?

  form      Form  @relation(fields: [form_id], references: [id], onDelete: Cascade)
  call      Call? @relation(fields: [call_id], references: [id], onDelete: Cascade)
  submitter User  @relation(fields: [submitted_by], references: [id], onDelete: Cascade)

  submission_metadata     SubmissionMetadata[]
  submission_calls        SubmissionCall[]
  submission_ticket_tasks SubmissionTicketTask[]
  submission_answers      SubmissionAnswer[]
  score_snapshots         ScoreSnapshot[]
  disputes                Dispute[]
  dispute_score_history   DisputeScoreHistory[]

  @@index([status, submitted_at], map: "idx_submissions_status_date")
  @@index([form_id, status, submitted_at], map: "idx_submissions_form_status_date")
  @@index([case_id], map: "idx_submissions_case_id")
  @@map("submissions")
}

/// Junction linking a Submission to one or more external CRM tickets/tasks.
/// Q-Tip stores ONLY the reference (kind + external_id); the ticket/task
/// header and notes are live-fetched from the CRM read-only pool every time
/// the section is rendered. See backend/src/services/CRMService.ts.
///
/// `external_id` is BigInt because tblTicket.TicketID is bigint(20) on the
/// CRM side; tblTask.TaskID is int but fits comfortably in BigInt.
enum TicketTaskKind {
  TICKET
  TASK
}

model SubmissionTicketTask {
  id            Int            @id @default(autoincrement())
  submission_id Int
  kind          TicketTaskKind
  external_id   BigInt
  sort_order    Int            @default(0)
  created_at    DateTime       @default(now()) @db.DateTime(0)

  submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, kind, external_id], name: "unique_submission_ticket_task")
  @@index([submission_id])
  @@index([kind, external_id], map: "idx_stt_external")
  @@map("submission_ticket_tasks")
}

model SubmissionMetadata {
  id            Int       @id @default(autoincrement())
  submission_id Int
  field_id      Int
  value         String?   @db.Text
