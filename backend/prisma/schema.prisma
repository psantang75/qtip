  csr                    User           @relation("WriteUpCsr", fields: [csr_id], references: [id], onDelete: Cascade)
  creator                User           @relation("WriteUpCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  manager                User?          @relation("WriteUpManager", fields: [manager_id], references: [id], onDelete: SetNull)
