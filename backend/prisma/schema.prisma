// Pre-production review item #96 — generator output location.
//
// We intentionally keep the generated Prisma client inside `src/generated/`
// (gitignored but in-tree) rather than pointing `output` at
// `node_modules/.prisma/client`:
//
//   - 60+ call sites import from `../generated/prisma/client`. Flipping to a
//     package-style import (`@prisma/client`) is a large cross-cutting
//     refactor and risks drift against the deployment pipeline
//     (`prisma generate` runs on every CI build and in Docker).
//   - The in-tree path gives editors and tsc consistent resolution without
//     relying on `node_modules` being present on disk (OneDrive-backed
//     workspaces on Windows have been known to virtualize node_modules).
//   - The trade-off is local TS compile cost — the generated files are
//     included by `tsconfig.json`'s `"src/**/*"` glob. If this becomes a
//     real bottleneck, switch to the node_modules output and migrate the
//     import paths in one dedicated pass.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id        Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)

  users              User[]
  insightsPageAccess IePageRoleAccess[]
  appPageAccess      AppPageRoleAccess[]

  @@map("roles")
}

model Department {
  id              Int     @id @default(autoincrement())
  department_name String  @unique @db.VarChar(100)
  is_active       Boolean @default(true) @db.TinyInt
  parent_id       Int?

  parent   Department?  @relation("DepartmentHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  users                         User[]
  department_managers           DepartmentManager[]
  calls                         Call[]
  performance_goals             PerformanceGoal[]
  performance_goal_departments  PerformanceGoalDepartment[]
  agent_activity                AgentActivity[]
  metric_departments            MetricDepartment[]
  metric_thresholds             MetricThreshold[]
  report_definition_departments ReportDefinitionDepartment[]
  schedule_coverage_thresholds  ScheduleCoverageThreshold[]
  schedule_coverage_windows     ScheduleCoverageWindow[]
  campaign_schedules            CampaignSchedule[]
  campaign_schedule_departments CampaignScheduleDepartment[]

  @@map("departments")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  role_id       Int
  department_id Int?
  is_active     Boolean   @default(true) @db.TinyInt
  last_login    DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.DateTime(0)
  title         String?   @db.VarChar(150)
  manager_id    Int?

  role           Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)
  department     Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  manager        User?       @relation("UserManager", fields: [manager_id], references: [id], onDelete: SetNull)
  direct_reports User[]      @relation("UserManager")

  forms_created                         Form[]
  performance_goals_created             PerformanceGoal[]           @relation("GoalCreatedBy")
  performance_goals_updated             PerformanceGoal[]           @relation("GoalUpdatedBy")
  performance_goal_users                PerformanceGoalUser[]       @relation("GoalUser")
  performance_goal_users_assigned       PerformanceGoalUser[]       @relation("GoalAssignedBy")
  performance_goal_departments_assigned PerformanceGoalDepartment[] @relation("DeptGoalAssignedBy")
  department_managers_mgr               DepartmentManager[]         @relation("DeptManagerMgr")
  department_managers_assigned          DepartmentManager[]         @relation("DeptManagerAssignedBy")
  courses_created                       Course[]
  coaching_sessions_csr                 CoachingSession[]           @relation("CoachingCsr")
  coaching_sessions_created             CoachingSession[]           @relation("CoachingCreatedBy")
  calls                                 Call[]
  submissions_submitted                 Submission[]
  score_snapshots                       ScoreSnapshot[]
  disputes_raised                       Dispute[]                   @relation("DisputeBy")
  disputes_resolved                     Dispute[]                   @relation("DisputeResolvedBy")
  dispute_score_history                 DisputeScoreHistory[]       @relation("ScoreHistoryRecordedBy")
  audit_logs                            AuditLog[]
  audit_assignments_created             AuditAssignment[]           @relation("AuditAssignmentCreatedBy")
  audit_assignments_qa                  AuditAssignment[]           @relation("AuditAssignmentQA")
  agent_activity                        AgentActivity[]
  report_definitions_created            ReportDefinition[]
  import_logs                           ImportLog[]
  call_activity_raw                     CallActivityRaw[]
  sales_margin_raw                      SalesMarginRaw[]
  lead_sales_margin_raw                 LeadSalesMarginRaw[]
  lead_source_raw                       LeadSourceRaw[]
  ticket_task_raw                       TicketTaskRaw[]
  email_stats_raw                       EmailStatsRaw[]
  punch_raw                             PunchRaw[]
  schedule_shifts                       ScheduleShift[]
  schedule_exceptions                   ScheduleException[]
  attendance_daily                      AttendanceDaily[]
  attendance_occurrences                AttendanceOccurrence[]
  quiz_attempts                         QuizAttempt[]
  training_resources                    TrainingResource[]
  write_ups_as_csr                      WriteUp[]          @relation("WriteUpCsr")
  write_ups_created                     WriteUp[]          @relation("WriteUpCreatedBy")
  write_ups_as_manager                  WriteUp[]          @relation("WriteUpManager")
  write_ups_as_hr_witness               WriteUp[]          @relation("WriteUpHrWitness")
  write_up_follow_ups                   WriteUp[]          @relation("WriteUpFollowUpAssignee")
  insightsOverrides                     IePageUserOverride[] @relation("InsightsOverrideUser")
  insightsOverridesGranted              IePageUserOverride[] @relation("InsightsOverrideGranter")

  password_reset_tokens                 PasswordResetToken[]
  email_templates_edited                EmailTemplate[]            @relation("EmailTemplateUpdatedBy")
  email_template_versions_edited        EmailTemplateVersion[]     @relation("EmailTemplateVersionEditedBy")
  email_logs_received                   EmailLog[]                 @relation("EmailLogToUser")
  notification_queue_entries            NotificationQueueEntry[]   @relation("NotificationQueueUser")

  @@index([last_login])
  @@index([role_id, is_active, department_id], map: "idx_users_role_active_dept")
  @@map("users")
}

/// Managed via raw SQL — Prisma must never modify this table
model ListItem {
  id         Int      @id @default(autoincrement())
  list_type  String   @db.VarChar(100)
  category   String?  @db.VarChar(100)
  label      String   @db.VarChar(255)
  item_key   String?  @db.VarChar(100)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@ignore
  @@map("list_items")
}


model Form {
  id                Int                 @id @default(autoincrement())
  form_name         String              @db.VarChar(100)
  interaction_type  FormInteractionType @default(UNIVERSAL)
  version           Int                 @default(1)
  created_by        Int
  created_at        DateTime            @default(now()) @db.DateTime(0)
  is_active         Boolean             @default(true) @db.TinyInt
  parent_form_id    Int?
  user_version      Int?
  user_version_date DateTime?           @db.Date
  critical_cap_percent Decimal           @default(79.00) @db.Decimal(5, 2)
  ai_enabled        Boolean             @default(false) @db.TinyInt
  ai_review_guidance String?            @db.Text
  ai_submit_as_draft Boolean            @default(false) @db.TinyInt
  ai_sample_review_pct       Int        @default(10) @db.UnsignedInt
  ai_sample_low_score_always Boolean    @default(true) @db.TinyInt
  ai_sample_low_confidence_threshold Decimal? @db.Decimal(3, 2)
  ai_calibration_auto_absorb_days  Int?     @default(180)
  ai_monthly_cost_budget_usd       Decimal? @db.Decimal(8, 2)
  ai_disagreement_route_threshold  Decimal? @db.Decimal(3, 2)
  /// Phase C (C2): max number of auto-attached secondary sources the
  /// case loader may pull in for combined ticket+call reviews. Default
  /// 3 keeps the prompt cost bounded; per-form override lets a noisy
  /// queue dial it down to 1 (primary-only effectively) or up to 10.
  ai_max_attached_sources          Int      @default(3) @db.UnsignedTinyInt
  /// Optional per-form base prompt assignment. NULL means "use the default
  /// for the requested `prompt_kind`" (system.v3 today). Lets domain-specific
  /// forms (sales, warranty, etc.) opt into a non-default base authored
  /// through the Base Prompt Library.
  ai_base_prompt_id                Int?
  /// Per-form AI model provider. Controls which LLM the synthesis pipeline
  /// (reasoning + answer chunks + verification) calls. Allowed values are
  /// "anthropic" (Claude — default, current behaviour) and "openai"
  /// (ChatGPT / GPT-5). Inherited across form versions through
  /// MySQLFormRepository.updateForm() so the choice survives Save Form.
  ai_model_provider                String   @default("anthropic") @db.VarChar(32)

  creator     User   @relation(fields: [created_by], references: [id], onDelete: Cascade)
  parent_form Form?  @relation("FormVersions", fields: [parent_form_id], references: [id], onDelete: SetNull)
  child_forms Form[] @relation("FormVersions")
  ai_base_prompt AiBasePrompt? @relation(fields: [ai_base_prompt_id], references: [id], onDelete: SetNull)

  form_metadata_fields   FormMetadataField[]
  form_categories        FormCategory[]
  audit_assignments      AuditAssignment[]
  submissions            Submission[]
  performance_goals_form PerformanceGoal[]   @relation("GoalTargetForm")

  @@index([interaction_type])
  @@index([ai_base_prompt_id], map: "idx_forms_ai_base_prompt")
  @@map("forms")
}

model FormMetadataField {
  id               Int                         @id @default(autoincrement())
  form_id          Int
  interaction_type FormMetadataInteractionType
  field_name       String                      @db.VarChar(100)
  field_type       FormMetadataFieldType
  is_required      Boolean                     @default(true) @db.TinyInt
  dropdown_source  String?                     @db.VarChar(1000)
  sort_order       Int                         @default(0)
  created_at       DateTime                    @default(now()) @db.DateTime(0)

  form                Form                 @relation(fields: [form_id], references: [id], onDelete: Cascade)
  submission_metadata SubmissionMetadata[]

  @@unique([form_id, interaction_type, field_name], name: "unique_form_field")
  @@map("form_metadata_fields")
}

model FormCategory {
  id            Int     @id @default(autoincrement())
  form_id       Int
  category_name String  @db.VarChar(100)
  description   String? @db.Text
  weight        Decimal @db.Decimal(5, 2)
  sort_order    Int     @default(0)

  form                       Form              @relation(fields: [form_id], references: [id], onDelete: Cascade)
  form_questions             FormQuestion[]
  performance_goals_category PerformanceGoal[] @relation("GoalTargetCategory")

  @@index([form_id, sort_order])
  @@map("form_categories")
}

model FormQuestion {
  id             Int              @id @default(autoincrement())
  category_id    Int
  question_text  String           @db.VarChar(255)
  question_type  FormQuestionType
  weight         Decimal          @db.Decimal(5, 2)
  sort_order     Int              @default(0)
  scale_min      Int?
  scale_max      Int?
  is_na_allowed  Boolean          @default(false) @db.TinyInt
  yes_value      Int              @default(1)
  no_value       Int              @default(0)
  na_value       Int              @default(0)
  visible_to_csr Boolean          @default(true) @db.TinyInt
  is_critical    Boolean          @default(false) @db.TinyInt

  /// Question authoring role. DETAIL (default) is a normal graded question.
  /// ROLLUP means the answer is computed at render/submit time from
  /// `rollup_member_question_ids` via the rule in `rollup_rule` (see
  /// backend/src/utils/rollupEngine.ts). The scoring engine treats both
  /// roles identically once an answer is present, so this field never
  /// changes how scoring works.
  role                       FormQuestionRole @default(DETAIL)
  /// Aggregation rule used when `role = ROLLUP`. Only ANY_NO_TO_NO is
  /// implemented today; the enum is open for future rules.
  rollup_rule                FormRollupRule?
  /// JSON array of FormQuestion IDs that contribute to this rollup. Only
  /// meaningful when `role = ROLLUP`. Members hidden by FormQuestionCondition
  /// at evaluation time are excluded (gate=NO -> action hidden -> not
  /// counted), so empty visible-member sets naturally roll up to N/A.
  rollup_member_question_ids Json?

  category                   FormCategory            @relation(fields: [category_id], references: [id], onDelete: Cascade)
  radio_options              RadioOption[]
  submission_answers         SubmissionAnswer[]
  conditions_source          FormQuestionCondition[] @relation("ConditionQuestion")
  conditions_target          FormQuestionCondition[] @relation("ConditionTarget")
  performance_goals_question PerformanceGoal[]       @relation("GoalTargetQuestion")

  @@index([category_id, sort_order])
  @@map("form_questions")
}

model RadioOption {
  id            Int      @id @default(autoincrement())
  question_id   Int
  option_text   String   @db.VarChar(255)
  option_value  String   @db.VarChar(255)
  score         Int      @default(0)
  has_free_text Boolean  @default(false) @db.TinyInt
  sort_order    Int      @default(0)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @default(now()) @updatedAt @db.DateTime(0)

  question          FormQuestion     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  free_text_answers FreeTextAnswer[]

  @@map("radio_options")
}

model PerformanceGoal {
  id                 Int                        @id @default(autoincrement())
  goal_type          PerformanceGoalType
  target_value       Decimal                    @db.Decimal(5, 2)
  scope              PerformanceGoalScope
  department_id      Int?
  description        String?                    @db.Text
  created_at         DateTime                   @default(now()) @db.DateTime(0)
  is_active          Boolean                    @default(true) @db.TinyInt
  created_by         Int?
  updated_by         Int?
  updated_at         DateTime?                  @db.DateTime(0)
  start_date         DateTime                   @default(dbgenerated("(curdate())")) @db.Date
  end_date           DateTime?                  @db.Date
  target_form_id     Int?
  target_category_id Int?
  target_question_id Int?
  target_scope       PerformanceGoalTargetScope @default(ALL_QA)

  department      Department?   @relation(fields: [department_id], references: [id], onDelete: SetNull)
  creator         User?         @relation("GoalCreatedBy", fields: [created_by], references: [id])
  updater         User?         @relation("GoalUpdatedBy", fields: [updated_by], references: [id])
  target_form     Form?         @relation("GoalTargetForm", fields: [target_form_id], references: [id], onDelete: SetNull)
  target_category FormCategory? @relation("GoalTargetCategory", fields: [target_category_id], references: [id], onDelete: SetNull)
  target_question FormQuestion? @relation("GoalTargetQuestion", fields: [target_question_id], references: [id], onDelete: SetNull)

  performance_goal_users       PerformanceGoalUser[]
  performance_goal_departments PerformanceGoalDepartment[]

  @@index([is_active, start_date, end_date])
  @@index([start_date, end_date])
  @@index([target_scope, target_form_id, target_category_id, target_question_id])
  @@map("performance_goals")
}

model PerformanceGoalUser {
  id          Int      @id @default(autoincrement())
  goal_id     Int
  user_id     Int
  assigned_at DateTime @default(now()) @db.DateTime(0)
  assigned_by Int
  is_active   Boolean  @default(true) @db.TinyInt

  goal     PerformanceGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  user     User            @relation("GoalUser", fields: [user_id], references: [id], onDelete: Cascade)
  assigner User            @relation("GoalAssignedBy", fields: [assigned_by], references: [id], onDelete: Cascade)

  @@unique([goal_id, user_id], name: "unique_goal_user")
  @@index([goal_id])
  @@index([user_id])
  @@index([assigned_by])
  @@map("performance_goal_users")
}

model PerformanceGoalDepartment {
  id            Int      @id @default(autoincrement())
  goal_id       Int
  department_id Int
  assigned_at   DateTime @default(now()) @db.DateTime(0)
  assigned_by   Int
  is_active     Boolean  @default(true) @db.TinyInt

  goal       PerformanceGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  department Department      @relation(fields: [department_id], references: [id], onDelete: Cascade)
  assigner   User            @relation("DeptGoalAssignedBy", fields: [assigned_by], references: [id], onDelete: Cascade)

  @@unique([goal_id, department_id], name: "unique_goal_department")
  @@index([goal_id])
  @@index([department_id])
  @@index([assigned_by])
  @@map("performance_goal_departments")
}

model FormQuestionCondition {
  id                 Int                         @id @default(autoincrement())
  question_id        Int
  target_question_id Int
  condition_type     FormQuestionConditionType
  target_value       String?                     @db.VarChar(255)
  logical_operator   FormQuestionLogicalOperator @default(AND)
  group_id           Int                         @default(0)
  sort_order         Int                         @default(0)
  created_at         DateTime                    @default(now()) @db.DateTime(0)

  question        FormQuestion @relation("ConditionQuestion", fields: [question_id], references: [id], onDelete: Cascade)
  target_question FormQuestion @relation("ConditionTarget", fields: [target_question_id], references: [id], onDelete: Cascade)

  @@map("form_question_conditions")
}

model AuditAssignment {
  id          Int                       @id @default(autoincrement())
  form_id     Int
  target_id   Int?
  target_type AuditAssignmentTargetType
  schedule    String?                   @db.VarChar(100)
  created_by  Int
  created_at  DateTime                  @default(now()) @db.DateTime(0)
  qa_id       Int?
  start_date  DateTime                  @db.DateTime(0)
  end_date    DateTime?                 @db.DateTime(0)
  is_active   Boolean                   @default(true) @db.TinyInt

  form    Form  @relation(fields: [form_id], references: [id], onDelete: Cascade)
  creator User  @relation("AuditAssignmentCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  qa_user User? @relation("AuditAssignmentQA", fields: [qa_id], references: [id], onDelete: SetNull)

  @@map("audit_assignments")
}

model DepartmentManager {
  id            Int      @id @default(autoincrement())
  department_id Int
  manager_id    Int
  assigned_at   DateTime @default(now()) @db.DateTime(0)
  assigned_by   Int
  is_active     Boolean  @default(true) @db.TinyInt

  department Department @relation(fields: [department_id], references: [id], onDelete: Cascade)
  manager    User       @relation("DeptManagerMgr", fields: [manager_id], references: [id], onDelete: Cascade)
  assigner   User       @relation("DeptManagerAssignedBy", fields: [assigned_by], references: [id], onDelete: Cascade)

  @@unique([department_id, manager_id], name: "unique_dept_manager")
  @@index([department_id])
  @@index([manager_id])
  @@map("department_managers")
}

model Course {
  id          Int      @id @default(autoincrement())
  course_name String   @db.VarChar(100)
  description String?  @db.Text
  created_by  Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  is_draft    Boolean  @default(true) @db.TinyInt

  creator User    @relation(fields: [created_by], references: [id], onDelete: Cascade)
  quizzes Quiz[]

  @@map("courses")
}



model Quiz {
  id         Int     @id @default(autoincrement())
  course_id  Int?
  quiz_title String  @db.VarChar(100)
  pass_score Decimal @db.Decimal(5, 2)
  is_active  Boolean @default(true) @db.TinyInt

  course            Course?           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  quiz_questions    QuizQuestion[]
  coaching_sessions CoachingSession[] @relation("CoachingSessionQuiz")
  quiz_attempts     QuizAttempt[]

  @@index([is_active])
  @@map("quizzes")
}

model QuizQuestion {
  id             Int    @id @default(autoincrement())
  quiz_id        Int
  question_text  String @db.VarChar(255)
  options        String @db.Text
  correct_option Int

  quiz Quiz @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}




model QuizAttempt {
  id                  Int              @id @default(autoincrement())
  quiz_id             Int
  user_id             Int
  coaching_session_id Int?
  answers_json        String           @db.Text
  score               Decimal          @db.Decimal(5, 2)
  passed              Boolean          @db.TinyInt
  attempt_number      Int              @default(1)
  submitted_at        DateTime         @default(now()) @db.DateTime(0)

  quiz             Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  coaching_session CoachingSession? @relation(fields: [coaching_session_id], references: [id], onDelete: SetNull)

  @@index([quiz_id, user_id])
  @@index([coaching_session_id])
  @@index([submitted_at, user_id], map: "idx_quiz_attempts_date_user")
  @@index([user_id, submitted_at], map: "idx_quiz_attempts_user_date")
  @@map("quiz_attempts")
}

model TrainingResource {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(255)
  resource_type  String   @default("URL") @db.VarChar(50)
  url            String?  @db.VarChar(500)
  file_path      String?  @db.VarChar(500)
  file_name      String?  @db.VarChar(255)
  file_size      Int?
  file_mime_type String?  @db.VarChar(100)
  description    String?  @db.Text
  is_active      Boolean  @default(true) @db.TinyInt
  created_by     Int
  created_at     DateTime @default(now()) @db.DateTime(0)
  updated_at     DateTime @default(now()) @updatedAt @db.DateTime(0)

  creator         User                    @relation(fields: [created_by], references: [id], onDelete: Cascade)
  coaching_sessions CoachingSession[]

  @@index([is_active])
  @@map("training_resources")
}

model CoachingSession {
  id                   Int                   @id @default(autoincrement())
  batch_id             String?               @db.VarChar(36)
  csr_id               Int
  session_date         DateTime              @db.DateTime(0)
  coaching_purpose     Int?                  // FK -> list_items.id (list_type='coaching_purpose')
  coaching_format      Int?                  // FK -> list_items.id (list_type='coaching_format')
  notes                String?               @db.Text
  attachment_filename  String?               @db.VarChar(255)
  attachment_path      String?               @db.VarChar(500)
  attachment_size      Int?
  attachment_mime_type String?               @db.VarChar(100)
  status               CoachingSessionStatus @default(SCHEDULED)
  created_at           DateTime              @default(now()) @db.DateTime(0)
  created_by           Int?

  source_type            Int?                 // FK -> list_items.id (list_type='coaching_source')
  qa_audit_id            Int?
  required_action        String?              @db.Text
  kb_resource_id         Int?
  kb_url                 String?              @db.VarChar(500)
  quiz_id                Int?
  quiz_required          Boolean              @default(false) @db.TinyInt
  require_acknowledgment Boolean              @default(true)  @db.TinyInt
  require_action_plan    Boolean              @default(true)  @db.TinyInt
  follow_up_required     Boolean              @default(false) @db.TinyInt
  follow_up_date         DateTime?            @db.DateTime(0)
  follow_up_notes        String?              @db.Text
  delivered_at           DateTime?            @db.DateTime(0)
  completed_at           DateTime?            @db.DateTime(0)
  closed_at              DateTime?            @db.DateTime(0)
  due_date               DateTime?            @db.DateTime(0)
  behavior_flags         String?              @db.VarChar(1000)
  internal_notes         String?              @db.Text
  csr_action_plan        String?              @db.Text
  csr_root_cause         String?              @db.VarChar(255)
  csr_support_needed     String?              @db.VarChar(255)
  csr_acknowledged_at    DateTime?            @db.DateTime(0)

  is_legacy            Boolean @default(false) @db.TinyInt
  legacy_coaching_type String? @db.VarChar(50)

  csr         User              @relation("CoachingCsr", fields: [csr_id], references: [id], onDelete: Cascade)
  creator     User?             @relation("CoachingCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  kb_resource TrainingResource? @relation(fields: [kb_resource_id], references: [id], onDelete: SetNull)
  quiz        Quiz?             @relation("CoachingSessionQuiz", fields: [quiz_id], references: [id], onDelete: SetNull)

  quiz_attempts           QuizAttempt[]
  write_ups               WriteUp[]

  @@index([created_by])
  @@index([csr_id, created_by])
  @@index([csr_id, coaching_purpose])
  @@index([session_date, coaching_purpose])
  @@index([coaching_purpose])
  @@index([coaching_format])
  @@index([session_date, status], map: "idx_coaching_date_status")
  @@index([csr_id, session_date], map: "idx_coaching_csr_date")
  @@index([batch_id], map: "idx_cs_batch_id")
  @@map("coaching_sessions")
}

model WriteUp {
  id                     Int            @id @default(autoincrement())
  csr_id                 Int
  document_type          WriteUpType
  status                 WriteUpStatus  @default(DRAFT)
  meeting_date           DateTime?      @db.DateTime(0)
