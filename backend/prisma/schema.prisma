  edited_by     Int?
  edited_at     DateTime     @default(now()) @db.DateTime(0)

  template EmailTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  editor   User?         @relation("EmailTemplateVersionEditedBy", fields: [edited_by], references: [id], onDelete: SetNull)

  @@index([template_id, version])
  @@map("email_template_versions")
}

enum EmailSendStatus {
  SENT
  FAILED
  SKIPPED_DISABLED
  SKIPPED_OFF
  SKIPPED_RATE_LIMIT
  SKIPPED_QUIET_HOURS
  SKIPPED_INACTIVE_USER
  SKIPPED_CIRCUIT_BREAKER
  SKIPPED_NOT_CONFIGURED
}

model EmailLog {
  id                   Int             @id @default(autoincrement())
  template_key         String          @db.VarChar(100)
  to_email             String          @db.VarChar(255)
  to_user_id           Int?
  subject              String          @db.Text
  status               EmailSendStatus
  error_message        String?         @db.Text
  message_id           String?         @db.VarChar(255)
  dedupe_key           String          @unique @db.VarChar(255)
  related_entity_type  String?         @db.VarChar(50)
  related_entity_id    Int?
  sent_at              DateTime?       @db.DateTime(0)
  created_at           DateTime        @default(now()) @db.DateTime(0)

  to_user User? @relation("EmailLogToUser", fields: [to_user_id], references: [id], onDelete: SetNull)

  @@index([to_user_id, created_at])
  @@index([template_key, created_at])
  @@index([status, created_at])
  @@map("email_log")
}

model NotificationQueueEntry {
  id            Int       @id @default(autoincrement())
  user_id       Int
  template_key  String    @db.VarChar(100)
  payload       Json
  scheduled_for DateTime  @db.DateTime(0)
  dedupe_key    String    @unique @db.VarChar(255)
  processed_at  DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)

  user User @relation("NotificationQueueUser", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([scheduled_for, processed_at])
  @@index([user_id, template_key])
