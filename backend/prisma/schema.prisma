// Audit trail for every LLM call made by the AI Reviewer (Phase 3 of the
// AI Reviewer Maturity Rollout). Inserts are fire-and-forget — a logging
// failure must never bubble up into the LLM call path.
model AiCallLog {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  created_at      DateTime @default(now()) @db.DateTime(3)
  provider        String   @db.VarChar(32)
  model           String   @db.VarChar(64)
  purpose         String   @db.VarChar(64)
  /**
   * Cross-cutting (X1): which two-pass stage produced this row.
   *   - 'classification' — Sonnet topic classifier mini-call (Phase B)
   *   - 'trace'          — Pass 1 per-source trace (Sonnet)
   *   - 'synthesis'      — Pass 2 cross-source synthesis (Opus)
   *   - 'verification'   — Phase A self-consistency re-check (Opus)
   *   - 'single_pass'    — legacy single-call path (pre-C3)
   * Backfilled to 'single_pass' on the existing fleet so historical
   * rollups keep working until callers migrate to the two-pass path.
   */
  pass            String   @default("single_pass") @db.VarChar(16)
  ticket_id       Int?     @db.UnsignedInt
  submission_id   Int?     @db.UnsignedInt
  form_id         Int?     @db.UnsignedInt
  /**
   * Cross-cutting (X1): groups every LLM call belonging to the same
   * multi-source review (matches submissions.case_id). NULL for legacy
   * rows and one-off calls (e.g. preview prompts) that don't belong
   * to a case.
   */
  case_id         String?  @db.VarChar(64)
  prompt_hash     String   @db.Char(64)
  prompt_chars    Int      @db.UnsignedInt
  response_chars  Int      @db.UnsignedInt
  tokens_in       Int?     @db.UnsignedInt
  tokens_out      Int?     @db.UnsignedInt
  elapsed_ms      Int      @db.UnsignedInt
  retried         Boolean  @default(false) @db.TinyInt
  success         Boolean  @db.TinyInt
  error_code      String?  @db.VarChar(64)
  error_message   String?  @db.Text

  @@index([ticket_id], map: "idx_ai_call_logs_ticket")
  @@index([submission_id], map: "idx_ai_call_logs_submit")
  @@index([created_at], map: "idx_ai_call_logs_created")
  @@index([pass], map: "idx_ai_call_logs_pass")
  @@index([case_id], map: "idx_ai_call_logs_case")
  @@map("ai_call_logs")
}

// AI Reviewer calibration data points. Each row captures the pair
// (ai_answers, human_answers) for one ticket on one form so we can compute
// rolling agreement and per-question drift. See backend/src/services/AICalibrationService.ts.
model AiCalibrationData {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  created_at           DateTime @default(now()) @db.DateTime(3)
  form_id              Int      @db.UnsignedInt
  ticket_id            Int      @db.UnsignedInt
  /// Phase B (B4): kind of external source `ticket_id` refers to —
  /// 'TICKET' (CRM ticket id, the historical default) or 'CALL'
  /// (Genesys call id, used by the CALL adapter). Backfilled to
  /// 'TICKET' for every existing row.
  source_kind          String   @default("TICKET") @db.VarChar(16)
  source               String   @db.VarChar(32)
  ai_submission_id     Int?     @db.UnsignedInt
  human_submission_id  Int?     @db.UnsignedInt
  ai_answers           Json?
  human_answers        Json
  graded_by            Int?     @db.UnsignedInt
  in_rolling_set       Boolean  @default(true) @db.TinyInt
  notes                String?  @db.Text
  absorbed_at          DateTime? @db.DateTime(3)
  absorbed_by          Int?      @db.UnsignedInt
  absorbed_reason      String?   @db.VarChar(255)

  @@index([form_id, created_at], map: "idx_calib_form_created")
  @@index([ticket_id], map: "idx_calib_ticket")
  @@index([ai_submission_id], map: "idx_calib_ai_sub")
  @@index([form_id, absorbed_at], map: "idx_calib_absorbed")
  @@index([form_id, source_kind], map: "idx_calib_form_source_kind")
  @@map("ai_calibration_data")
}

// Cached embeddings for BookStack pages (Phase 4 of the AI Reviewer
// Maturity Rollout). Vectors are stored as packed Float32 byte arrays in
// MEDIUMBLOB so we don't need MySQL 9's VECTOR type. The crawl is
// idempotent — content_sha skips re-embedding pages whose plaintext is
// unchanged.
model KbPageEmbedding {
  page_id        Int      @id @db.UnsignedInt
  page_name      String   @db.VarChar(500)
  page_url       String   @db.VarChar(500)
  book_slug      String   @db.VarChar(150)
  content_sha    String   @db.Char(64)
  embedding      Bytes    @db.MediumBlob
  embedding_dims Int      @db.UnsignedSmallInt
  chars          Int      @db.UnsignedInt
  crawled_at     DateTime @db.DateTime(3)

  @@index([book_slug], map: "idx_kb_book")
  @@map("kb_page_embeddings")
}

/// Phase D (D2): structured QTIP metadata extracted from BookStack page
/// front-matter at crawl time. Lets the AI Reviewer filter/score KB
/// pages by review kind (`qtip_applies_to`) and authority
/// (`qtip_authority`) without re-parsing markdown on every prompt
/// build. Pages without a front-matter block don't get a row here.
///
/// JSON columns are MySQL JSON arrays so they can be queried with
/// JSON_CONTAINS at filter time. `playbook_steps` (D3) is the ordered
/// list of step names extracted from the page's `Steps` section so the
/// trace prompt can inject the canonical step list directly instead of
/// asking the model to re-derive it from page bodies.
model KbPageMeta {
  page_id          Int      @id @db.UnsignedInt
  qtip_role        String?  @db.VarChar(64)
  qtip_applies_to  Json?
  qtip_steps       Json?
  qtip_authority   String?  @db.VarChar(64)
  playbook_steps   Json?
  parsed_at        DateTime @db.DateTime(3)

  @@index([qtip_authority], map: "idx_kb_meta_authority")
  @@map("kb_pages_meta")
}

/// Held-out evaluation set per form (AI Reviewer Industry Parity Phase 3).
/// Auto-seeded from promoted-and-unchanged AI submissions; humans can
/// also manually mark a submission as golden via the submission detail UI.
/// The unique key on submission_id keeps the auto-seeder idempotent.
/// Soft-archive via archived_at instead of hard delete so historical eval
/// runs stay reproducible.
model AiGoldenSet {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  form_id       Int       @db.UnsignedInt
  submission_id Int       @db.UnsignedInt
  source        String    @db.VarChar(16)
  marked_by     Int?      @db.UnsignedInt
  marked_at     DateTime  @default(now()) @db.DateTime(3)
  notes         String?   @db.VarChar(500)
  archived_at   DateTime? @db.DateTime(3)

  @@unique([submission_id], map: "uk_golden_submission")
  @@index([form_id, archived_at], map: "idx_golden_form")
  @@map("ai_golden_set")
}

/// Per-form, versioned isotonic-regression bins fit by
/// ConfidenceCalibratorFitter (Phase 4b). Versioned so an admin can
/// preview the next-version map before flipping `is_active` — and so
/// historical eval runs can replay against the map active at run time.
model AiCalibrationMap {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  form_id      Int      @db.UnsignedInt
  version      Int      @db.UnsignedInt
  fitted_at    DateTime @default(now()) @db.DateTime(3)
  sample_count Int      @db.UnsignedInt
  bins_json    Json
  is_active    Boolean  @default(false) @db.TinyInt
  notes        String?  @db.VarChar(500)

  @@unique([form_id, version], map: "uk_calib_map_form_version")
  @@index([form_id, is_active], map: "idx_calib_map_active")
  @@map("ai_calibration_map")
}

/// One row per execution of the golden-set eval runner (Phase 3c).
/// Stored centrally (not in a JSON file) so the latest-run card on the
/// AI Reviewer detail page can show kappa + delta vs. the previous run,
/// and so a CI gate can compare the current vs. previous run kappa.
/// prompt_hash + pack_hashes_json pin the exact prompt this run was
/// evaluating — critical when investigating "why did kappa drop?".
model AiEvalRun {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  form_id           Int      @db.UnsignedInt
  ran_at            DateTime @default(now()) @db.DateTime(3)
  triggered_by      String   @db.VarChar(32)
  triggered_by_user Int?     @db.UnsignedInt
  golden_set_count  Int      @db.UnsignedInt
  prompt_hash       String   @db.Char(64)
  pack_hashes_json  Json
  results_json      Json
  overall_kappa     Decimal? @db.Decimal(4, 3)
  pass              Boolean  @db.TinyInt

  @@index([form_id, ran_at], map: "idx_eval_form_ran")
  @@map("ai_eval_runs")
}

/// Per-(form, question) grading rubric authored by QA admins on the
/// AI Reviewer Form Detail page. Renders as the indented "RUBRIC:" block
/// under the question in the synthesis prompt
/// ([backend/src/services/aiReviewerTwoPassPrompts.ts](backend/src/services/aiReviewerTwoPassPrompts.ts) `renderFormSpec`).
///
/// Replaced the file-based convention `backend/prompts/form-rubrics/<form_id>.md`
/// (Tier-2 Item 6) so that authoring lives in the UI rather than the repo.
/// Empty/missing rows are normal — most questions don't need a rubric.
model AiFormQuestionRubric {
  id          Int      @id @default(autoincrement())
  form_id     Int
  question_id Int
  rubric_md   String   @db.MediumText
  updated_by  Int?
  created_at  DateTime @default(now()) @db.DateTime(3)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(3)

  @@unique([form_id, question_id], map: "uk_rubric_form_question")
  @@index([form_id], map: "idx_rubric_form")
  @@map("ai_form_question_rubric")
}

/// Library of reusable rule packs that get rendered into the AI Reviewer
/// system prompt for any form they're assigned to. Replaces the file-based
/// `backend/prompts/rule-packs/*.md` convention so department leads can
/// edit pack bodies through the Rule Pack Library UI without a code change.
///
/// `key` is the human-readable slug and remains the public identifier
/// (it's what the chip-picker and `pack_hashes_json` in `ai_eval_runs`
/// reference). Soft-deleted via `is_archived` so historical eval runs
/// can still resolve the pack a submission ran against.
model AiRulePack {
  id                       Int      @id @default(autoincrement())
  key                      String   @unique(map: "uk_rule_pack_key") @db.VarChar(64)
  name                     String   @db.VarChar(255)
  owner_dept               String   @db.VarChar(64)
  body_md                  String   @db.MediumText
  always_include_urls_json Json
  is_archived              Boolean  @default(false) @db.TinyInt
  updated_by               Int?
  created_at               DateTime @default(now()) @db.DateTime(3)
  updated_at               DateTime @default(now()) @updatedAt @db.DateTime(3)

  assignments AiFormRulePackAssignment[]

  @@index([owner_dept, is_archived], map: "idx_rule_pack_dept")
  @@map("ai_rule_pack")
}

/// Many-to-many: which rule packs are assigned to which forms. Replaces
/// the runtime-written JSON file `backend/config/ai-form-rule-packs.json`
/// (whose `fs.writeFileSync` was unsafe on multi-instance / read-only FS
/// deployments).
///
/// `sort_order` preserves the picker order so packs render deterministically
/// in the prompt. ON DELETE CASCADE on both sides keeps assignments tidy
/// when a pack is hard-deleted or a form is removed.
model AiFormRulePackAssignment {
  id           Int      @id @default(autoincrement())
  form_id      Int
  rule_pack_id Int
  sort_order   Int      @default(0)
  updated_by   Int?
  created_at   DateTime @default(now()) @db.DateTime(3)

  rule_pack AiRulePack @relation(fields: [rule_pack_id], references: [id], onDelete: Cascade)

  @@unique([form_id, rule_pack_id], map: "uk_form_rule_pack")
  @@index([form_id], map: "idx_form_rule_pack_form")
  @@map("ai_form_rule_pack_assignment")
}

/// Library of universal base prompts the AI Reviewer concatenates with
/// rule packs + per-form guidance + learned corrections at run time.
/// Replaces the file-based convention `backend/prompts/ai-reviewer/<key>.md`
/// so admins can author / edit / roll back bases through the Base Prompt
/// Library page without a code change.
///
/// `prompt_kind` partitions the table by which builder consumes the
/// base (`single_source`, `trace`, `synthesis`). One row per kind has
/// `is_default = true`; forms that don't pick a specific base fall back
/// to that default. Soft-deleted via `is_archived` so historical eval
/// runs can still resolve the base a submission ran against.
model AiBasePrompt {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique(map: "uk_base_prompt_key") @db.VarChar(64)
  name                 String   @db.VarChar(255)
  description          String?  @db.Text
  prompt_kind          String   @db.VarChar(32)
  current_version_id   Int?
  is_default           Boolean  @default(false) @db.TinyInt
  is_archived          Boolean  @default(false) @db.TinyInt
  updated_by           Int?
  created_at           DateTime @default(now()) @db.DateTime(3)
  updated_at           DateTime @default(now()) @updatedAt @db.DateTime(3)

  current_version AiBasePromptVersion?  @relation("CurrentBaseVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions        AiBasePromptVersion[] @relation("BaseVersions")
  forms           Form[]

  @@index([prompt_kind, is_default, is_archived], map: "idx_base_prompt_kind_default")
  @@map("ai_base_prompt")
}

/// Immutable history rows for `ai_base_prompt`. Every save creates a new
/// row; the parent's `current_version_id` updates to point at it.
/// Rollback creates a NEW row whose body is a copy of an older version,
/// so the timeline reads forward-only and never erases history.
model AiBasePromptVersion {
  id             Int      @id @default(autoincrement())
  base_prompt_id Int
  version        Int
  body_md        String   @db.MediumText
  change_note    String?  @db.VarChar(500)
  created_by     Int?
  created_at     DateTime @default(now()) @db.DateTime(3)

  base_prompt    AiBasePrompt   @relation("BaseVersions", fields: [base_prompt_id], references: [id], onDelete: Cascade, map: "fk_base_prompt_version_parent")
  current_for    AiBasePrompt[] @relation("CurrentBaseVersion")

  @@unique([base_prompt_id, version], map: "uk_base_prompt_version")
  @@index([base_prompt_id, version(sort: Desc)], map: "idx_base_prompt_version_history")
  @@map("ai_base_prompt_version")
}

// =====================================================================
// Email / Notification system
//
// See docs/email_notification_system.md and the qtip-email-system plan.
// All recipients are employees; there is no per-user opt-out. Admins
// configure copy and cadence via /admin/email-templates. Locked templates
// (security/critical workflow) cannot be disabled.
// =====================================================================

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  user_id     Int
  token_hash  String    @db.Char(64)
  expires_at  DateTime  @db.DateTime(0)
  used_at     DateTime? @db.DateTime(0)
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime  @default(now()) @db.DateTime(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token_hash])
  @@index([user_id])
  @@map("password_reset_tokens")
}

enum EmailCadence {
  IMMEDIATE
  DAILY
  WEEKLY
}

enum EmailDigestFilter {
  ALL
  BELOW_THRESHOLD
  ROUTED_TO_QA
}

model EmailTemplate {
  id                 Int               @id @default(autoincrement())
  template_key       String            @unique @db.VarChar(100)
  category           String            @db.VarChar(50)
  name               String            @db.VarChar(255)
  description        String?           @db.Text
  subject            String            @db.Text
  body_html          String            @db.LongText
  body_text          String?           @db.Text
  cadence            EmailCadence      @default(IMMEDIATE)
  digest_filter      EmailDigestFilter @default(ALL)
  is_enabled         Boolean           @default(true) @db.TinyInt
  is_locked          Boolean           @default(false) @db.TinyInt
  allowed_variables  Json
  available_roles    Json
  recipient_roles    Json
  recipient_summary  String            @db.VarChar(500)
  version            Int               @default(1)
  updated_by         Int?
  updated_at         DateTime          @default(now()) @updatedAt @db.DateTime(0)
  created_at         DateTime          @default(now()) @db.DateTime(0)

  updater  User?                  @relation("EmailTemplateUpdatedBy", fields: [updated_by], references: [id], onDelete: SetNull)
  versions EmailTemplateVersion[]

  @@index([category])
  @@map("email_templates")
}

model EmailTemplateVersion {
  id            Int          @id @default(autoincrement())
  template_id   Int
  version       Int
  subject       String       @db.Text
  body_html     String       @db.LongText
  body_text     String?      @db.Text
