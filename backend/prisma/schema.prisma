// Paychex punch/time-clock segments. One row per punch pair (in/out). Loaded
// via manual admin upload (and later an automated inbox poller). Dedup key is
// `post_id` (Paychex "Post ID"), which is unique per punch — the importer
// upserts on it so overlapping/re-sent exports never duplicate and edits heal.
model PunchRaw {
  id               Int       @id @default(autoincrement())
  post_id          String    @unique @db.VarChar(50)
  user_id          Int
  punch_in_at      DateTime? @db.DateTime(0)
  punch_out_at     DateTime? @db.DateTime(0)
  punch_type_in    String?   @db.VarChar(50)
  punch_type_out   String?   @db.VarChar(50)
  /// Paychex pay type on the block — Work, Break, Meal, or a time-off reason such
  /// as "PTO - Approved". What lets a Non-Work block become a typed exception.
  pay_type         String?   @db.VarChar(50)
  regular_duration Decimal   @default(0) @db.Decimal(10, 2)
  import_id        Int?
  created_at       DateTime  @default(now()) @db.DateTime(0)
  updated_at       DateTime  @default(now()) @updatedAt @db.DateTime(0)

  user   User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  import ImportLog? @relation(fields: [import_id], references: [id], onDelete: SetNull)

  @@index([user_id, punch_in_at])
  @@map("punch_raw")
}

